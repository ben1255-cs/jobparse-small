# Copy this file to .env and fill it in. Never commit .env to GitHub.
# Any OpenAI-compatible API works. Leave LLM_BASE_URL blank for OpenAI itself.
LLM_API_KEY=your-key-here
LLM_BASE_URL=
LLM_MODEL=your-model-name   # e.g. a small, cheap model from your provider

# Optional: use different models for writing the adverts and for the baseline
LLM_GENERATOR_MODEL=
LLM_BASELINE_MODEL=
